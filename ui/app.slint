import { ScrollView, LineEdit, Button, CheckBox, ComboBox } from "std-widgets.slint";

export struct ChangelogRow { text: string, heading: bool, code: bool }

export struct DeviceRow {
    id: string,
    title: string,
    hardware-name: string,
    serial: string,
    hardware-id: string,
    kind: string,
    category: string,
    percentage: string,
    level: float,
    fresh: bool,
    has-battery: bool,
    present: bool,
    status: string,
    updated: string,
    alias: string,
    identity-note: string,
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: touch.has-hover ? #e2e3e7 : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }
    Image { width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: root.icon; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component DeviceCard inherits Rectangle {
    in property <DeviceRow> data;
    private property <bool> show-hardware-name: root.data.alias != "" && root.data.alias != root.data.hardware-name;
    callback edit();
    callback delete-device();
    height: 208px;
    border-radius: 16px;
    border-width: 1px;
    border-color: data.present ? #e2e3e7 : #e1e2e6;
    background: #ffffff;

    Rectangle {
        x: 16px; y: 17px; width: 43px; height: 43px;
        border-radius: 12px; background: root.data.present ? #efeff2 : #f1f1f3;
        Image { x: 8px; y: 8px; width: 27px; height: 27px; source: root.data.kind == "mouse" ? @image-url("../assets/mouse.svg") : root.data.kind == "keyboard" ? @image-url("../assets/keyboard.svg") : root.data.kind == "gamepad" ? @image-url("../assets/gamepad.svg") : data.kind == "headset" ? @image-url("../assets/headset.svg") : @image-url("../assets/device.svg"); opacity: root.data.present ? 1 : 0.45; }
    }
    Text { x: 71px; y: 17px; width: parent.width - (root.data.present ? 120px : 152px); height: 25px; text: root.data.title; font-size: 17px; font-weight: 600; color: #18181b; overflow: elide; }
    Text { x: 71px; y: 43px; width: parent.width - 100px; height: 18px; text: root.data.category; font-size: 11px; color: #76767e; overflow: elide; }
    Rectangle {
        x: parent.width - 40px; y: 14px; width: 26px; height: 26px; border-radius: 7px;
        background: edit-touch.has-hover ? #ececef : transparent;
        Image { x: 5px; y: 5px; width: 16px; height: 16px; source: @image-url("../assets/edit.svg"); }
        edit-touch := TouchArea { mouse-cursor: pointer; clicked => { root.edit(); } }
        accessible-role: button; accessible-label: "编辑备注"; accessible-action-default => { root.edit(); }
    }
    if !root.data.present: IconButton {
        x: parent.width - 74px; y: 11px;
        icon: @image-url("../assets/delete.svg"); label: "删除离线记录";
        clicked => { root.delete-device(); }
    }

    Text { x: 18px; y: 75px; width: 140px; height: 45px; text: root.data.percentage; font-size: 35px; font-weight: 500; color: root.data.fresh && root.data.has-battery ? #18181b : #97979f; }
    Text { x: parent.width - 146px; y: 93px; width: 128px; height: 18px; text: root.data.status; horizontal-alignment: right; font-size: 11px; color: root.data.fresh ? #27272a : #929299; overflow: elide; }
    Rectangle {
        x: 18px; y: 125px; width: parent.width - 36px; height: 5px; border-radius: 3px; background: #e5e5e9;
        Rectangle { x: 0px; y: 0px; width: parent.width * root.data.level; height: parent.height; border-radius: 3px; background: !root.data.fresh || !root.data.has-battery ? #c5c5cc : root.data.level < 0.3 ? #e47e35 : #27272a; }
    }
    if root.show-hardware-name: Text { x: 18px; y: 140px; width: parent.width - 36px; height: 17px; text: root.data.hardware-name; color: #6c6c74; font-size: 11px; overflow: elide; }
    Text { x: 18px; y: root.show-hardware-name ? 162px : 143px; width: parent.width - 36px; height: 17px; text: root.data.hardware-id; color: #7a7a82; font-size: 10px; overflow: elide; }
    Text { x: 18px; y: root.show-hardware-name ? 185px : 171px; width: parent.width - 36px; height: 14px; text: root.data.updated; color: #8c8c94; font-size: 10px; overflow: elide; }
}

component MiniPanel inherits Rectangle {
    in property <[DeviceRow]> devices;
    in property <string> updated: "尚未刷新";
    in property <string> notice;
    in property <bool> busy;
    callback expand();
    callback hide-window();
    callback refresh();

    Rectangle { border-width: 1px; border-color: #d5d5dc; border-radius: 12px; background: transparent; }
    Image { x: 12px; y: 12px; width: 18px; height: 18px; source: @image-url("../assets/brand.svg"); }
    Text { x: 38px; y: 12px; width: parent.width - 122px; height: 18px; text: "Periph In One"; font-size: 12px; font-weight: 600; color: #18181b; }
    IconButton { x: parent.width - 78px; y: 5px; icon: @image-url("../assets/expand.svg"); label: "展开完整面板"; clicked => { root.expand(); } }
    IconButton { x: parent.width - 42px; y: 5px; icon: @image-url("../assets/close.svg"); label: "隐藏到托盘"; clicked => { root.hide-window(); } }

    ScrollView {
        x: 12px; y: 42px; width: parent.width - 24px; height: parent.height - 80px;
        viewport-width: self.visible-width;
        viewport-height: max(self.visible-height, root.devices.length * 48px);
        for data[index] in root.devices: Rectangle {
            x: 0px;
            y: index * 48px;
            width: parent.width;
            height: 48px;

            Image { x: 0px; y: 6px; width: 18px; height: 18px; source: data.kind == "mouse" ? @image-url("../assets/mouse.svg") : data.kind == "keyboard" ? @image-url("../assets/keyboard.svg") : data.kind == "gamepad" ? @image-url("../assets/gamepad.svg") : data.kind == "headset" ? @image-url("../assets/headset.svg") : @image-url("../assets/device.svg"); }
            Text { x: 26px; y: 2px; width: parent.width - 84px; height: 18px; text: data.title; font-size: 12px; color: data.fresh ? #18181b : #6c6c74; overflow: elide; }
            Text {
                x: parent.width - 58px; y: 0px; width: 58px; height: 22px;
                text: data.percentage;
                font-size: 15px; font-weight: 600; horizontal-alignment: right;
                color: data.fresh && data.has-battery ? (data.level < 0.3 ? #e47e35 : #27272a) : #76767e;
            }
            Text {
                x: 26px; y: 22px; width: parent.width - 26px; height: 14px;
                text: data.fresh ? data.updated : data.status + " · " + data.updated;
                font-size: 10px; color: #6c6c74; overflow: elide;
            }
            Rectangle {
                x: 26px; y: 42px; width: parent.width - 26px; height: 3px; border-radius: 1.5px; background: #e5e5e9;
                Rectangle {
                    x: 0px; y: 0px;
                    width: parent.width * data.level; height: parent.height; border-radius: 1.5px;
                    background: !data.fresh || !data.has-battery ? #c5c5cc : data.level < 0.3 ? #e47e35 : #27272a;
                }
            }
        }
    }
    if root.devices.length == 0: Text {
        x: 10px; y: 42px; width: parent.width - 20px; height: 42px;
        text: root.busy ? "正在寻找设备…" : "未发现设备";
        horizontal-alignment: center; vertical-alignment: center; color: #7b7b84;
    }

    Text {
        x: 14px; y: parent.height - 27px; width: parent.width - 66px; height: 18px;
        text: root.notice != "" ? root.notice : (root.busy ? "正在读取设备…" : root.updated);
        font-size: 10px; vertical-alignment: center; overflow: elide;
        color: root.notice != "" ? #bb6425 : #797982;
    }
    IconButton { x: parent.width - 42px; y: parent.height - 37px; icon: @image-url("../assets/refresh.svg"); label: "立即刷新"; clicked => { if !root.busy { root.refresh(); } } }
}

export component AppWindow inherits Window {
    title: "Periph In One";
    preferred-width: root.mini-mode ? 280px : 360px;
    preferred-height: root.mini-mode ? root.mini-height : 640px;
    in-out property <bool> mini-mode;
    out property <length> mini-height: min(368px, 80px + max(1, root.devices.length) * 48px);
    min-width: root.mini-mode ? 280px : 320px;
    max-width: root.mini-mode ? 280px : 65535px;
    min-height: root.mini-mode ? root.mini-height : 340px;
    max-height: root.mini-mode ? root.mini-height : 65535px;
    background: #edeef2;
    no-frame: true;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;
    icon: @image-url("../assets/app-icon.png");

    in property <[DeviceRow]> devices;
    in property <string> summary: "等待设备";
    in property <string> updated: "尚未刷新";
    in property <string> notice;
    in property <bool> busy;
    in-out property <bool> settings-open;
    in-out property <bool> autostart;
    in property <string> app-version;
    in-out property <bool> automatic-update;
    in property <bool> update-working;
    in property <bool> update-ready;
    in property <string> update-status;
    in property <bool> update-available;
    in property <string> update-version;
    in property <[ChangelogRow]> update-notes;
    in-out property <bool> updates-open;
    in-out property <bool> editing;
    in-out property <bool> deleting;
    in-out property <string> deleting-id;
    in-out property <string> deleting-name;
    in-out property <string> editing-id;
    in-out property <string> editing-name;
    in-out property <string> editing-alias;
    in-out property <string> editing-serial;
    in property <string> editing-hardware-id;
    in property <bool> editing-has-name;
    in property <bool> editing-has-serial;
    in-out property <string> editing-identity;
    in property <[string]> rebind-options;
    private property <int> columns: root.width > root.height ? max(1, floor((root.width - 30px) / 280px)) : 1;
    callback refresh();
    callback hide-window();
    callback expand();
    callback edit-device(string);
    callback save-remark(string, string);
    callback rebind-remark(string, int);
    callback copy-serial(string);
    callback copy-name(string);
    callback copy-hardware-id(string);
    callback delete-device(string);
    callback toggle-autostart(bool);
    callback toggle-update(bool);
    callback download-update();
    callback restart-update();
    callback open-release();

    if root.mini-mode: MiniPanel {
        width: 100%;
        height: 100%;
        devices: root.devices;
        updated: root.updated;
        notice: root.notice;
        busy: root.busy;
        expand => { root.expand(); }
        hide-window => { root.hide-window(); }
        refresh => { root.refresh(); }
    }

    if !root.mini-mode: Rectangle {
        width: 100%;
        height: 100%;
        Rectangle { border-width: 1px; border-color: #d5d5dc; border-radius: 16px; background: transparent; }
        Image { x: 22px; y: 25px; width: 38px; height: 38px; source: @image-url("../assets/brand.svg"); }
        Text { x: 72px; y: 21px; width: parent.width - (root.update-available ? 214px : 174px); height: 31px; text: "Periph In One"; font-size: 20px; font-weight: 700; color: #18181b; overflow: elide; }
        Text { x: 73px; y: 54px; width: parent.width - 96px; height: 18px; text: root.summary; font-size: 11px; color: #7b7b84; overflow: elide; }
        IconButton { x: parent.width - 92px; y: 28px; icon: @image-url("../assets/settings.svg"); label: "设置"; clicked => { root.settings-open = !root.settings-open; } }
        if root.update-available: IconButton { x: parent.width - 132px; y: 28px; icon: @image-url("../assets/up.svg"); label: "查看新版本"; clicked => { root.settings-open = false; root.updates-open = true; } }
        IconButton { x: parent.width - 52px; y: 28px; icon: @image-url("../assets/close.svg"); label: "隐藏到托盘"; clicked => { root.hide-window(); } }

        ScrollView {
            x: 18px; y: 90px; width: parent.width - 36px; height: parent.height - 150px;
            viewport-width: self.visible-width;
            viewport-height: max(self.visible-height, ceil(root.devices.length / root.columns) * 220px);
            for data[index] in root.devices: DeviceCard {
                width: (parent.width - (root.columns - 1) * 12px) / root.columns;
                x: mod(index, root.columns) * (self.width + 12px);
                y: floor(index / root.columns) * 220px;
                data: data;
                edit => { root.edit-device(data.id); }
                delete-device => {
                    root.deleting-id = data.id;
                    root.deleting-name = data.title;
                    root.settings-open = false;
                    root.editing = false;
                    root.deleting = true;
                }
            }
            if root.devices.length == 0: Rectangle {
                width: parent.width; height: 220px;
                border-radius: 16px; border-width: 1px; border-color: #dfdfe5; background: #ffffff;
                Image { x: (parent.width - 48px) / 2; y: 40px; width: 48px; height: 48px; source: @image-url("../assets/brand.svg"); }
                Text { x: 16px; y: 106px; width: parent.width - 32px; height: 24px; text: root.busy ? "正在寻找设备…" : "还没有发现设备"; horizontal-alignment: center; font-size: 16px; font-weight: 600; color: #303035; }
                Text { x: 20px; y: 143px; width: parent.width - 40px; height: 45px; text: "请连接设备接收器"; horizontal-alignment: center; wrap: word-wrap; font-size: 11px; color: #82828b; }
            }
        }

        Text { x: 24px; y: parent.height - 46px; width: parent.width - 84px; height: 18px; text: root.busy ? "正在读取设备…" : root.updated; font-size: 11px; color: #797982; overflow: elide; }
        if root.notice != "": Text { x: 24px; y: parent.height - 25px; width: parent.width - 48px; height: 18px; text: root.notice; font-size: 10px; color: #bb6425; overflow: elide; }
        IconButton { x: parent.width - 54px; y: parent.height - 54px; icon: @image-url("../assets/refresh.svg"); label: "立即刷新"; clicked => { if !root.busy { root.refresh(); } } }

        if root.settings-open || root.editing || root.deleting || root.updates-open: Rectangle {
            background: #10101455;
            TouchArea { clicked => { root.settings-open = false; root.editing = false; root.deleting = false; root.updates-open = false; } }
        }

        if root.settings-open: Rectangle {
            x: max(16px, (parent.width - 360px) / 2); y: max(24px, (parent.height - self.height) / 2);
            width: min(parent.width - 32px, 360px); height: min(parent.height - 48px, root.update-status != "" && !root.update-available ? 245px : 210px);
            border-radius: 16px; background: #ffffff;
            TouchArea { clicked => {} }
            ScrollView {
            viewport-width: self.visible-width;
            VerticalLayout {
                padding: 22px; spacing: 12px;
                HorizontalLayout { Text { text: "设置"; font-size: 20px; font-weight: 600; color: #18181b; } IconButton { icon: @image-url("../assets/close.svg"); label: "关闭设置"; clicked => { root.settings-open = false; } } }
                CheckBox { text: "开机启动"; checked <=> root.autostart; toggled => { root.toggle-autostart(self.checked); } }
                CheckBox { text: "自动更新"; checked <=> root.automatic-update; toggled => { root.toggle-update(self.checked); } }
                Text { text: "版本 " + root.app-version; color: #64646e; font-size: 12px; }
                if root.update-status != "" && !root.update-available: Text { text: root.update-status; color: #64646e; font-size: 12px; wrap: word-wrap; }
            }
            }
        }

        if root.updates-open: Rectangle {
            x: max(16px, (parent.width - 480px) / 2); y: max(24px, (parent.height - self.height) / 2);
            width: min(parent.width - 32px, 480px); height: min(parent.height - 48px, 480px);
            border-radius: 16px; background: #ffffff;
            TouchArea { clicked => {} }
            VerticalLayout {
                padding: 22px; spacing: 16px;
                HorizontalLayout {
                    min-height: 32px; max-height: 32px;
                    Text { text: "新版本 " + root.update-version; font-size: 18px; font-weight: 600; color: #18181b; overflow: elide; }
                    IconButton { icon: @image-url("../assets/close.svg"); label: "关闭更新窗口"; clicked => { root.updates-open = false; } }
                }
                ScrollView {
                    viewport-width: self.visible-width;
                    VerticalLayout {
                        spacing: 10px; alignment: start;
                        for note in root.update-notes: Text {
                            text: note.text; wrap: word-wrap; color: #303035;
                            font-size: note.heading ? 16px : 12px; font-weight: note.heading ? 600 : 400;
                            font-family: note.code ? "Consolas" : "Microsoft YaHei UI";
                        }
                        if root.update-notes.length == 0: Text { text: "该版本暂无更新说明"; color: #797982; font-size: 12px; }
                    }
                }
                if root.update-status != "": Text { text: root.update-status; color: #64646e; font-size: 12px; wrap: word-wrap; }
                HorizontalLayout {
                    min-height: 36px; max-height: 36px; spacing: 12px;
                    Button { text: "发布页面"; clicked => { root.open-release(); } }
                    if root.update-ready: Button { text: "重启并更新"; enabled: !root.update-working; clicked => { root.restart-update(); } }
                    if !root.update-ready && !root.update-working: Button { text: "下载更新"; clicked => { root.download-update(); } }
                }
            }
        }

        if root.editing: Rectangle {
            x: max(16px, (parent.width - 390px) / 2); y: max(18px, (parent.height - self.height) / 2);
            width: min(parent.width - 32px, 390px); height: min(parent.height - 36px, root.rebind-options.length > 0 ? 480px : 356px);
            border-radius: 16px; background: #ffffff;
            TouchArea { clicked => {} }
            ScrollView {
                viewport-width: self.visible-width;
                VerticalLayout {
                    padding: 22px; spacing: 12px; alignment: start;
                    HorizontalLayout { Text { text: "设备备注"; font-size: 20px; font-weight: 600; color: #18181b; } IconButton { icon: @image-url("../assets/close.svg"); label: "取消编辑"; clicked => { root.editing = false; } } }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: root.editing-name; color: #64646e; font-size: 12px; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                        if root.editing-has-name: IconButton { icon: @image-url("../assets/copy.svg"); label: "复制硬件名称"; clicked => { root.copy-name(root.editing-id); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: root.editing-serial; color: #72727b; font-size: 11px; wrap: char-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                        if root.editing-has-serial: IconButton { icon: @image-url("../assets/copy.svg"); label: "复制序列号"; clicked => { root.copy-serial(root.editing-id); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: root.editing-hardware-id; color: #72727b; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                        if root.editing-hardware-id != "": IconButton { icon: @image-url("../assets/copy.svg"); label: "复制硬件标识"; clicked => { root.copy-hardware-id(root.editing-id); } }
                    }
                    if root.editing-identity != "": Text { text: root.editing-identity; color: #bb6425; font-size: 10px; wrap: word-wrap; }
                    LineEdit { min-height: 36px; max-height: 36px; text <=> root.editing-alias; placeholder-text: "例如：办公鼠标"; accepted => { root.save-remark(root.editing-id, root.editing-alias); } }
                    Button { min-height: 36px; max-height: 36px; text: "保存"; primary: false; clicked => { root.save-remark(root.editing-id, root.editing-alias); } }
                    if root.notice != "": Text { text: root.notice; color: #bb6425; font-size: 10px; wrap: word-wrap; }
                    if root.rebind-options.length > 0: VerticalLayout {
                        spacing: 8px;
                        Text { text: "离线记录"; font-size: 11px; color: #72727b; }
                        source-record := ComboBox { model: root.rebind-options; }
                        Button { text: "恢复备注"; clicked => { root.rebind-remark(root.editing-id, source-record.current-index); } }
                    }
                }
            }
        }

        if root.deleting: Rectangle {
            x: max(16px, (parent.width - 360px) / 2); y: (parent.height - self.height) / 2;
            width: min(parent.width - 32px, 360px); height: 170px;
            border-radius: 16px; background: #ffffff;
            TouchArea { clicked => {} }
            VerticalLayout {
                padding: 22px; spacing: 12px;
                Text { text: "删除离线记录？"; font-size: 18px; font-weight: 600; color: #18181b; }
                Text { text: root.deleting-name; color: #64646e; overflow: elide; }
                HorizontalLayout {
                    spacing: 12px;
                    Button { text: "取消"; clicked => { root.deleting = false; } }
                    Button { text: "删除"; clicked => { root.delete-device(root.deleting-id); } }
                }
            }
        }
    }
}
